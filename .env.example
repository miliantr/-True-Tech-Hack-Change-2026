# Copy to .env for the web prototype. Never commit .env or real credentials.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DATA_DIR=Данные
HOST=127.0.0.1
PORT=8000
# Published Docker Compose port. PORT still controls python app.py.
HOST_PORT=8000
RUNTIME_DIR=runtime
# Empty: generate runtime/reviewer-token.txt on first start.
REVIEW_TOKEN=
# Default needs only the generation endpoint. Hybrid and reranking are optional.
RETRIEVAL_MODE=lexical
EMB_MODEL=baai/bge-m3
USE_RERANKER=0
RERANKER_MODEL=qwen/qwen3-reranker-8b
TOP_K=16
RERANKER_TOP_N=6
MAX_TOKENS=2048
TEMPERATURE=0
MAX_WORKERS=3
API_TIMEOUT=45
RUN_BUDGET_SECONDS=1080
# Required only behind a configured reverse proxy, e.g. https://demo.example.com
PUBLIC_ORIGIN=
